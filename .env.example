# Grantly AI — Production Environment Configuration Example
# Supabase Backend Configuration (Required)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Optional server-side aliases for full-stack Node/Vercel SSR
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Gemini AI (Server-Side Only — Never expose to browser)
GEMINI_API_KEY="your-gemini-api-key"